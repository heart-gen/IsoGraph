{
  "dataset_name": "realistic_v1",
  "description": "Realistic simulation: 50 % non-switching genes, variable isoform counts (2\u20135), NB overdispersion, shared confounder. Equal-sized modules.",
  "feature_tables": [
    {
      "filename": "genes.parquet",
      "kind": "gene",
      "n_rows": 200
    },
    {
      "filename": "transcripts.parquet",
      "kind": "transcript",
      "n_rows": 572
    },
    {
      "filename": "psi.parquet",
      "kind": "psi",
      "n_rows": 200
    },
    {
      "filename": "truth_modules.parquet",
      "kind": "truth_module",
      "n_rows": 100
    },
    {
      "filename": "truth_switch.parquet",
      "kind": "truth_switch",
      "n_rows": 200
    }
  ],
  "matrices": [
    {
      "assay_name": "gene_counts",
      "encoding": "dense_npz",
      "filename": "gene_counts.npz",
      "n_features": 200,
      "n_samples": 160
    },
    {
      "assay_name": "transcript_counts",
      "encoding": "dense_npz",
      "filename": "transcript_counts.npz",
      "n_features": 572,
      "n_samples": 160
    },
    {
      "assay_name": "psi",
      "encoding": "dense_npz",
      "filename": "psi.npz",
      "n_features": 200,
      "n_samples": 160
    }
  ],
  "provenance": {
    "confounder_weight": "0.3",
    "count_dispersion": "5.0",
    "generator": "realistic_v1",
    "module_sizes": "[20, 20, 20, 20, 20]",
    "seed": "9",
    "switching_fraction": "0.5"
  },
  "sample_table": "samples.parquet",
  "suite_name": "core_v1",
  "truth_tables": [
    "truth_modules.parquet",
    "truth_switch.parquet"
  ]
}